### 전체 상품 목록 조회 (페이지 1, 5개씩)
GET http://localhost:4000/api/products?page=1&limit=5
Accept: application/json

### 전체 상품 목록 조회 + 검색
GET http://localhost:4000/api/products?search=노트북&sort=recent
Accept: application/json

### 전체 상품 목록 조회 + 최신순
GET http://localhost:4000/api/products?sort=recent
Accept: application/json

### 상품 상세 조회 
GET http://localhost:4000/api/products/1
Accept: application/json

### 상품 등록
POST http://localhost:4000/api/products
Content-Type: application/json

{
  "name": "Celular",
  "description": "좋은 제품",
  "price": 12000000,
  "tags": ["Test51", "Hate"]
}


### 상품 수정 
PATCH http://localhost:4000/api/products/1
Content-Type: application/json

{
  "price": 111112,
  "likeCount": 77
}


### 상품 삭제 
DELETE http://localhost:4000/api/products/1

#################################################

### 게시글 등록
POST http://localhost:4000/api/articles
Content-Type: application/json

{
  "title": "세번째 글",
  "content": "안녕하세요 자유게시판!",
  "author": "Bana",
  "likeCount": 0
}

### 게시글 목록 조회 (페이지 1, 5개)
GET http://localhost:4000/api/articles?page=1&limit=5&sort=recent&search=마우스


###
GET http://localhost:4000/api/articles


### 게시글 단건 조회
GET http://localhost:4000/api/articles/9

### 게시글 수정
PATCH http://localhost:4000/api/articles/13
Content-Type: application/json

{
  "title": "두두두번째 매각????",
  "content": "내용도 수정됨1ㄷㄹㅈㄹㄷ",
  "author": "우아나"
}

### 게시글 삭제
DELETE http://localhost:4000/api/articles/23

### 게시글 좋아요 증가
PATCH http://localhost:4000/api/articles/1/like

#################################################
### 댓글 등록
POST http://localhost:4000/api/comments
Content-Type: application/json

{
  "content": "첫 댓글이에요!",
  "articleId": 1,
  "author": "Dana"
}

### 댓글 수정
PATCH http://localhost:4000/api/comments/42
Content-Type: application/json

{
  "content": "수정된 댓글입니다."
}

### 댓글 삭제
DELETE http://localhost:4000/api/comments/42

### 댓글 목록 조회 
GET http://localhost:4000/api/comments?articleId=1&limit=5

### 댓글 목록 조회 (커서 기반)
GET http://localhost:4000/api/comments?articleId=1&limit=3&cursor=5

### 대댓글 등록
POST http://localhost:4000/api/comments
Content-Type: application/json

{
  "articleId": 2,
  "parentId": 6,
  "content": "2번 댓글에 대한 대댓글이에요!",
  "author": "Dana"
}

### 댓글 목록 조회 (계층형)
GET http://localhost:4000/api/comments?articleId=1&nested=true
